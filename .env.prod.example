# Dashboard — ПРОДАКШН-окружение. Скопируй в .env.prod и ЗАДАЙ СЕКРЕТЫ.
#   cp .env.prod.example .env.prod && nano .env.prod
# Файл .env.prod в .gitignore — не коммить секреты.

# --- Обязательные секреты (без них deploy.sh не стартует) ---
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
MINIO_PASSWORD=CHANGE_ME_strong_minio_password
JWT_SECRET=CHANGE_ME_long_random_string_min_32_chars
ADMIN_PASSWORD=CHANGE_ME_admin_password
# Временный пароль владельца-суперадмина (логин superadmin). Роль выше admin —
# управление любым пользователем, включая администраторов. Смена обязательна при
# первом входе. Задайте СИЛЬНЫЙ пароль.
SUPERADMIN_PASSWORD=CHANGE_ME_superadmin_password

# --- Прочее (можно оставить по умолчанию) ---
POSTGRES_DB=dashbord
POSTGRES_USER=dashbord
MINIO_USER=dashbord
ADMIN_LOGIN=admin
SUPERADMIN_LOGIN=superadmin

# Порт веб-интерфейса (nginx) на хосте. Внутри LAN открывать этот порт.
WEB_PORT=8090
# HTTPS-порт (при deploy.sh --tls, самоподписанный сертификат для LAN)
HTTPS_PORT=8443

# --- TLS-сертификат (deploy.sh --tls / install.sh, самоподписанный для LAN) ---
# Имя/IP сервера, под который выпускается сертификат (SAN). Если не задано —
# то же самое можно передать разово: TLS_CN=... TLS_SAN=... ./deploy.sh --tls.
#TLS_CN=
#TLS_SAN=

# --- Жизненный цикл данных и защита входа: НАСТРАИВАЮТСЯ В ИНТЕРФЕЙСЕ ---
# Раздел «Настройки» (администратор или суперадминистратор), значения хранятся
# в БД и применяются без перезапуска:
#   • окно хранения данных, месяцев — 0 выключает удаление;
#     там же предпросмотр «что именно удалится» перед запуском;
#   • свежесть данных: сколько дней без новых данных считать поводом
#     для уведомления;
#   • блокировка входа: сколько неудачных попыток и на сколько минут.
# Переменных RETENTION_MONTHS, STALE_DAYS, LOGIN_MAX_ATTEMPTS и
# LOGIN_LOCKOUT_MINUTES здесь БОЛЬШЕ НЕТ, и это не упущение: значение из БД
# всё равно побеждает, поэтому правка .env молча не давала бы ничего. Раньше
# они в шаблоне стояли, и «RETENTION_MONTHS=0» читался как «удаление
# выключено», тогда как система продолжала еженедельно удалять выпуски
# старше 12 месяцев (дефект найден аудитом 14.09).

# --- Автобэкап по расписанию (ставится install.sh автоматически; --no-backup чтобы отказаться) ---
# Время ежедневного бэкапа HH:MM и сколько наборов хранить (ротация).
BACKUP_TIME=03:30
BACKUP_KEEP=7
# Куда складывать бэкапы. НАСТОЯТЕЛЬНО рекомендуется ОТДЕЛЬНЫЙ диск/раздел или
# сетевая папка (NFS/SMB): бэкап на том же диске не переживёт отказ диска.
# По умолчанию — ./backups рядом с проектом (только для старта).
#BACKUP_DIR=/mnt/backup/dashbord

# --- Парольная политика и срок сессии ---
# Единственные пороги, у которых НЕТ экрана в интерфейсе, поэтому задаются
# здесь и применяются при перезапуске стека (./deploy.sh).
# Минимальная длина и требование сложности (и буквы, и цифры). Не применяется
# к первичному ADMIN_PASSWORD из bootstrap.
# Для госсистемы без второго фактора разумно поднять длину до 12.
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_COMPLEXITY=true
# Срок жизни токена, минут (720 = 12 ч). Смена/сброс пароля и блокировка
# учётки отзывают ранее выданные токены немедленно.
JWT_EXPIRE_MINUTES=720

# --- Доверенные прокси (адрес в журналах) ---
# Чьим заголовкам X-Real-IP / X-Forwarded-For верить, записывая адрес в журнал
# аудита и журнал входов. Заголовок присылает сам клиент, поэтому верить ему
# можно только когда запрос пришёл ОТ прокси — иначе адрес в журнале подделает
# кто угодно, а журнал отвечает «кто и откуда» при разборе инцидента.
# Пусто (по умолчанию) — приватные сети и loopback: адрес контейнера nginx в
# docker-сети заранее неизвестен. Сузить до конкретного адреса имеет смысл,
# если API доступен не только через nginx.
#TRUSTED_PROXIES=172.18.0.5


# --- Пины образов (воспроизводимость / офлайн / старые CPU) ---
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
# MinIO latest требует x86-64-v2 — на старом CPU ВМ падает; держим пин.
MINIO_IMAGE=minio/minio:RELEASE.2022-10-24T18-35-07Z

# --- Наблюдаемость (docker-compose.monitoring.yml) ---
GRAFANA_PASSWORD=CHANGE_ME_grafana_admin_password
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
# Пины образов мониторинга (офлайн/воспроизводимость)
PROMETHEUS_IMAGE=prom/prometheus:v2.54.1
GRAFANA_IMAGE=grafana/grafana:11.2.0
LOKI_IMAGE=grafana/loki:3.1.1
PROMTAIL_IMAGE=grafana/promtail:3.1.1
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.8.2
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.49.1

# Число рабочих процессов API (uvicorn). По умолчанию 2. На сервере с 8+ ГБ ОЗУ
# и 4+ ядрами можно поднять до 4 — каждый процесс держит свой пул подключений к БД.
API_WORKERS=2
