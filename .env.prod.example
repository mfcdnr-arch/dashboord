# Dashboard — ПРОДАКШН-окружение. Скопируй в .env.prod и ЗАДАЙ СЕКРЕТЫ.
#   cp .env.prod.example .env.prod && nano .env.prod
# Файл .env.prod в .gitignore — не коммить секреты.

# --- Обязательные секреты (без них deploy.sh не стартует) ---
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
MINIO_PASSWORD=CHANGE_ME_strong_minio_password
JWT_SECRET=CHANGE_ME_long_random_string_min_32_chars
ADMIN_PASSWORD=CHANGE_ME_admin_password
# Временный пароль владельца-суперадмина (логин superadmin). Роль выше admin —
# управление любым пользователем, включая администраторов. Смена обязательна при
# первом входе. Задайте СИЛЬНЫЙ пароль.
SUPERADMIN_PASSWORD=CHANGE_ME_superadmin_password

# --- Прочее (можно оставить по умолчанию) ---
POSTGRES_DB=dashbord
POSTGRES_USER=dashbord
MINIO_USER=dashbord
ADMIN_LOGIN=admin
SUPERADMIN_LOGIN=superadmin

# Порт веб-интерфейса (nginx) на хосте. Внутри LAN открывать этот порт.
WEB_PORT=8090
# HTTPS-порт (при deploy.sh --tls, самоподписанный сертификат для LAN)
HTTPS_PORT=8443

# --- Жизненный цикл данных (планировщик в сервисе worker) ---
# Ретенция: окно хранения данных датасетов, месяцев (0 — выключить прунинг).
# Еженедельно (вс 03:00) удаляются релизы с периодом старше окна. Перед первым
# включением проверьте объём: POST /maintenance/retention/preview (admin).
RETENTION_MONTHS=12
# Свежесть: если по объекту нет новых данных дольше N дней — уведомление (ежедневно 07:00).
STALE_DAYS=45

# --- Автобэкап по расписанию (backup-schedule.sh install) ---
# Время ежедневного бэкапа HH:MM и сколько наборов хранить (ротация).
BACKUP_TIME=03:30
BACKUP_KEEP=7

# --- Парольная политика (смена/сброс/создание пароля пользователя) ---
# Минимальная длина и требование сложности (и буквы, и цифры). Не применяется
# к первичному ADMIN_PASSWORD из bootstrap.
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_COMPLEXITY=true

# --- Защита входа от подбора пароля ---
# После LOGIN_MAX_ATTEMPTS неудач за LOGIN_LOCKOUT_MINUTES вход по логину
# временно блокируется (429). 0 — выключить блокировку.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Пины образов (воспроизводимость / офлайн / старые CPU) ---
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
# MinIO latest требует x86-64-v2 — на старом CPU ВМ падает; держим пин.
MINIO_IMAGE=minio/minio:RELEASE.2022-10-24T18-35-07Z
