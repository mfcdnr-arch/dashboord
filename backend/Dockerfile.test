# Образ для ПРОГОНА ТЕСТОВ и статического анализа. В прод не попадает.
#
# Почему отдельный файл, а не `pip install` в прод-образ: прод-образ должен
# оставаться без pytest/ruff/mypy — это и лишние 160 МБ, и лишняя поверхность.
# А почему вообще образ, а не `docker exec` в работающий api: в прод-образе нет
# ни pytest, ни каталога tests (Dockerfile копирует только app/), и то, что
# тесты там когда-то запускались, держалось на занесённой руками копии —
# она молча устаревала и давала ложное «зелено» (31.08.2026).
#
# Сборка:
#     docker build -t dashbord-test:py312 -f backend/Dockerfile.test backend
# Обычно собирать руками не нужно: сервис `tests` в docker-compose.yml собирает
# этот образ сам, если его нет на машине.
#
# Код внутрь НЕ копируется намеренно: app/, tests/ и frontend/ монтируются при
# запуске, поэтому прогон всегда идёт по рабочему дереву, а не по слепку,
# сделанному в момент сборки образа.
FROM python:3.12-slim

WORKDIR /app

# requirements-dev.txt начинается с `-r requirements.txt`, поэтому нужны оба
# файла: pip разрешает ссылку относительно каталога сборки.
COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt

# Тесты и линтеры читают эти файлы по путям /app/pytest.ini и /app/pyproject.toml.
# В compose они ещё и монтируются поверх — здесь они на случай запуска образа
# без монтирований (например, разовой проверкой «а собирается ли вообще»).
COPY pytest.ini pyproject.toml ./

CMD ["python", "-m", "pytest", "-q"]
