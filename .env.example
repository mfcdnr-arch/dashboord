# Dashbord — переменные окружения (скопируй в .env и при необходимости поменяй).
# Порты подобраны так, чтобы не конфликтовать с проектом DS на этой же машине.

# PostgreSQL
POSTGRES_DB=dashbord
POSTGRES_USER=dashbord
POSTGRES_PASSWORD=dashbord
POSTGRES_PORT=55432

# Redis
REDIS_PORT=6380

# MinIO (хранилище загруженных документов)
MINIO_USER=dashbord
MINIO_PASSWORD=dashbord123
MINIO_API_PORT=9800
MINIO_CONSOLE_PORT=9801
